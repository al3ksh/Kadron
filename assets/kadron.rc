IDI_ICON1 ICON "kadron.ico"

#include <winver.h>

#define KADRON_STR(x) #x
#define KADRON_VERSION_TEXT(a, b, c) KADRON_STR(a.b.c)
#define KADRON_RC_VERSION KADRON_VERSION_TEXT(KADRON_VERSION_MAJOR, KADRON_VERSION_MINOR, KADRON_VERSION_PATCH)

VS_VERSION_INFO VERSIONINFO
FILEVERSION KADRON_VERSION_MAJOR, KADRON_VERSION_MINOR, KADRON_VERSION_PATCH, 0
PRODUCTVERSION KADRON_VERSION_MAJOR, KADRON_VERSION_MINOR, KADRON_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Aleks Szotek"
            VALUE "FileDescription", "Kadron Media Studio"
            VALUE "FileVersion", KADRON_RC_VERSION
            VALUE "InternalName", "kadron"
            VALUE "LegalCopyright", "Copyright (C) 2026 Aleks Szotek. GPL-3.0."
            VALUE "OriginalFilename", "kadron.exe"
            VALUE "ProductName", "Kadron"
            VALUE "ProductVersion", KADRON_RC_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
